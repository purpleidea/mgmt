import "fmt"
import "net/esphome"

$endpoint = "esphome-conveyor"
$motor = "Conveyor Motor"

$entry_present = esphome.binary_sensor($endpoint, "Entry Object Present")
$exit_present = esphome.binary_sensor($endpoint, "Exit Object Present")
$color_ready = esphome.binary_sensor($endpoint, "Exit Color Ready")
$run_request = esphome.binary_sensor($endpoint, "Conveyor Run Request")
$red = esphome.sensor($endpoint, "Exit Red")
$green = esphome.sensor($endpoint, "Exit Green")
$blue = esphome.sensor($endpoint, "Exit Blue")
$clear = esphome.sensor($endpoint, "Exit Clear")
$confidence = esphome.sensor($endpoint, "Exit Color Confidence")
$candidate = esphome.text_sensor($endpoint, "Exit Color Candidate")
$detected_color = esphome.text_sensor($endpoint, "Exit Detected Color")

esphome:endpoint $endpoint {
	host => "esphome-conveyor.local",
	# Public sample key: replace it here and in the firmware before real use.
	key => "kJ7hc0lJ0Zw9N3DcJzXn1kJ7hc0lJ0Zw9N3DcJzXn1k=",
	interval => 0,
	logs => "info",
}

esphome:fan $motor {
	endpoint => $endpoint,
	state => if $run_request {
		"on"
	} else {
		"off"
	},
	speed => 100,
	direction => "forward",
	# On a long outage, stop before retrying the desired state. The firmware
	# lease, persistent fault latch, runtime limit, and physical stop remain the
	# authoritative safety layers.
	stop => 5,
	Meta:retry => -1,
	Meta:delay => 5000,
}

print "conveyor telemetry" {
	msg => fmt.printf(
		"entry=%v exit=%v color-ready=%v run=%v exit-rgbc=(%f, %f, %f, %f) candidate=%s confidence=%f detected=%s",
		$entry_present,
		$exit_present,
		$color_ready,
		$run_request,
		$red,
		$green,
		$blue,
		$clear,
		$candidate,
		$confidence,
		$detected_color,
	),
}

Esphome:Endpoint[$endpoint] -> Esphome:Fan[$motor]
