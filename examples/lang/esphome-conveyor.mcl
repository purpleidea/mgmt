# Run the mgmt + ESPHome conveyor demonstration with native, encrypted API
# control. mgmt owns the desired conveyor state. ESPHome owns GPIO/I2C details,
# local status-light effects, color capture/classification, and the safety rules
# that must still work without mgmt.
#
# This is a development-bench example, not a machine-safety system. Before
# energizing a motor, review the real board pinout and DRV8833 wiring, add a
# current limit and guards, and wire a physical emergency stop in series with
# the motor supply or driver enable. A software stop is not an emergency stop.
# Keep hands, hair, clothing, and loose parts clear of the belt.
#
# Copy the commented firmware below into esphome-conveyor.yaml. It targets the
# actual bench hardware tested by the accompanying CircuitPython programs:
#
#   Unexpected Maker FeatherS2:
#     ESPHome board: um_feathers2
#     MCU: ESP32-S2
#   DRV8833:
#     AIN1: CircuitPython board.D21 -> FeatherS2 GPIO38
#     AIN2: CircuitPython board.D20 -> FeatherS2 GPIO33
#     SLP:  CircuitPython board.D5  -> FeatherS2 GPIO1
#   TCA9548A:
#     SDA: CircuitPython board.SDA -> FeatherS2 GPIO8
#     SCL: CircuitPython board.SCL -> FeatherS2 GPIO9
#     address: 0x70
#   APDS9960 sensors:
#     entry sensor: TCA9548A channel 0, address 0x39, proximity only
#     exit sensor:  TCA9548A channel 1, address 0x39, proximity and RGBC
#   FeatherS2 onboard APA102:
#     data:  GPIO40
#     clock: GPIO45
#
# Color calibration notes:
#   The exact FeatherS2 and exit APDS9960 were bench-tested with proximity and
#   color enabled together, gesture disabled, 4x color gain, and 72 integration
#   cycles (about 200ms). The firmware averages five stationary samples, then
#   compares the normalized RGB mix with prototypes measured for red, blue,
#   green, white, and yellow LEGO bricks.
#
#   "Exit Color Confidence" is a conservative 0-100 heuristic, not a calibrated
#   probability. It combines visible-light signal strength, distance from the
#   nearest prototype, and separation from the second-nearest prototype. The
#   60% acceptance threshold is deliberately above the strongest false match
#   observed in the labeled white-brick captures. Yellow produced several
#   high-confidence clusters above that threshold. Green and white overlap blue
#   and yellow under the current illumination and will often remain unknown.
#
#   ESPHome's APDS9960 component reports each channel as ADC/65535*100, not as
#   an RGB mixture, and currently initializes ATIME to 0xDB (about 103ms). The
#   boot lambda below overrides only the exit sensor ATIME to 0xB8, matching the
#   successful 72-cycle CircuitPython test.
#
# Put wifi_ssid and wifi_password in ESPHome's secrets.yaml, replace the public
# sample API key in both files, then validate before flashing:
#
#   esphome config esphome-conveyor.yaml
#   esphome run esphome-conveyor.yaml
#
# Run mgmt after a human has inspected the bench and released the physical stop:
#
#   mgmt run --tmp-prefix lang examples/lang/esphome-conveyor.mcl
#
# Firmware targets the ESPHome 2026.7.x component schemas:
#
# esphome:
#   name: esphome-conveyor
#   friendly_name: mgmt ESPHome Conveyor
#   on_boot:
#     priority: -100
#     then:
#       # Keep DRV8833 asleep before touching the H-bridge state.
#       - output.turn_off: motor_sleep
#       - fan.turn_off: conveyor_motor
#       - light.turn_off: status_light
#       # ESPHome currently sets APDS9960 ATIME=0xDB (~103ms). The bench test
#       # used 72 x 2.78ms ~= 200ms, or ATIME=256-72=184=0xB8.
#       - lambda: |-
#           if (!id(exit_apds).write_byte(0x81, 0xB8)) {
#             ESP_LOGW("conveyor", "Failed to set exit APDS9960 color integration to 200ms");
#           } else {
#             ESP_LOGI("conveyor", "Exit APDS9960 color integration set to 200ms");
#           }
#
# esp32:
#   board: um_feathers2
#   variant: esp32s2
#   flash_size: 16MB
#   framework:
#     type: esp-idf
#
# wifi:
#   ssid: !secret wifi_ssid
#   password: !secret wifi_password
#   ap:
#     ssid: "esphome-conveyor-fallback"
#     password: "purpleIdea"
#     ap_timeout: 5min
#
# captive_portal:
#
# logger:
#   level: DEBUG
#
# api:
#   id: native_api
#   encryption:
#     # Public demo key. Generate a unique key for every real device.
#     key: "kJ7hc0lJ0Zw9N3DcJzXn1kJ7hc0lJ0Zw9N3DcJzXn1k="
#   reboot_timeout: 5min
#
# ota:
#   - platform: esphome
#
# # The fault latch survives a reboot. Only the explicit reset button clears
# # it; neither an API reconnect nor a repeated fan command auto-resumes motion.
# globals:
#   - id: motor_fault
#     type: bool
#     restore_value: yes
#     initial_value: "false"
#   - id: status_mode
#     type: int
#     restore_value: no
#     initial_value: "-1"
#   - id: color_sum_red
#     type: float
#     restore_value: no
#     initial_value: "0.0"
#   - id: color_sum_green
#     type: float
#     restore_value: no
#     initial_value: "0.0"
#   - id: color_sum_blue
#     type: float
#     restore_value: no
#     initial_value: "0.0"
#   - id: color_sum_clear
#     type: float
#     restore_value: no
#     initial_value: "0.0"
#   - id: color_sample_count
#     type: int
#     restore_value: no
#     initial_value: "0"
#
# # FeatherS2 STEMMA/Qwiic I2C pins used by CircuitPython board.SDA/board.SCL.
# i2c:
#   - id: main_i2c
#     sda: GPIO8
#     scl: GPIO9
#     scan: true
#
# tca9548a:
#   - id: sensor_mux
#     i2c_id: main_i2c
#     address: 0x70
#     channels:
#       - bus_id: entry_i2c
#         channel: 0
#       - bus_id: exit_i2c
#         channel: 1
#
# # Keep a 100ms polling interval so proximity remains responsive. The exit
# # APDS9960 runs proximity and color together. No gesture entities are defined.
# apds9960:
#   - id: entry_apds
#     i2c_id: entry_i2c
#     address: 0x39
#     update_interval: 100ms
#   - id: exit_apds
#     i2c_id: exit_i2c
#     address: 0x39
#     update_interval: 100ms
#     ambient_light_gain: 4x
#
# sensor:
#   # Entry is intentionally proximity-only.
#   - platform: apds9960
#     apds9960_id: entry_apds
#     type: PROXIMITY
#     id: entry_proximity
#     name: Entry Proximity
#
#   - platform: apds9960
#     apds9960_id: exit_apds
#     type: PROXIMITY
#     id: exit_proximity
#     name: Exit Proximity
#
#   # Raw exit RGBC values remain internal so the 100ms APDS9960 polling does not
#   # chatter over the native API. The capture script publishes one five-sample
#   # average per stopped object through the template sensors below.
#   - platform: apds9960
#     apds9960_id: exit_apds
#     type: RED
#     id: exit_red_raw
#     internal: true
#   - platform: apds9960
#     apds9960_id: exit_apds
#     type: GREEN
#     id: exit_green_raw
#     internal: true
#   - platform: apds9960
#     apds9960_id: exit_apds
#     type: BLUE
#     id: exit_blue_raw
#     internal: true
#   - platform: apds9960
#     apds9960_id: exit_apds
#     type: CLEAR
#     id: exit_clear_raw
#     internal: true
#
#   - platform: template
#     id: exit_red
#     name: Exit Red
#     unit_of_measurement: "%"
#     accuracy_decimals: 3
#     update_interval: never
#   - platform: template
#     id: exit_green
#     name: Exit Green
#     unit_of_measurement: "%"
#     accuracy_decimals: 3
#     update_interval: never
#   - platform: template
#     id: exit_blue
#     name: Exit Blue
#     unit_of_measurement: "%"
#     accuracy_decimals: 3
#     update_interval: never
#   - platform: template
#     id: exit_clear
#     name: Exit Clear
#     unit_of_measurement: "%"
#     accuracy_decimals: 3
#     update_interval: never
#   - platform: template
#     id: exit_color_confidence
#     name: Exit Color Confidence
#     unit_of_measurement: "%"
#     accuracy_decimals: 1
#     update_interval: never
#
# text_sensor:
#   - platform: template
#     id: exit_color_candidate
#     name: Exit Color Candidate
#     update_interval: never
#   - platform: template
#     id: exit_detected_color
#     name: Exit Detected Color
#     update_interval: never
#
# binary_sensor:
#   - platform: template
#     id: entry_object_present
#     name: Entry Object Present
#     lambda: return id(entry_proximity).has_state() && id(entry_proximity).state >= 20.0;
#   - platform: template
#     id: exit_object_present
#     name: Exit Object Present
#     # Keep the early-presence threshold for telemetry.
#     lambda: return id(exit_proximity).has_state() && id(exit_proximity).state >= 20.0;
#   - platform: template
#     id: exit_capture_position
#     internal: true
#     # 70% is approximately raw proximity 179 on the APDS9960.
#     lambda: return id(exit_proximity).has_state() && id(exit_proximity).state >= 70.0;
#     on_press:
#       - script.execute: capture_exit_color
#     on_release:
#       - script.stop: capture_exit_color
#       - lambda: |-
#           id(exit_color_ready).publish_state(false);
#           id(exit_color_candidate).publish_state("none");
#           id(exit_detected_color).publish_state("none");
#           id(exit_color_confidence).publish_state(0.0f);
#       - script.execute: update_status_light
#   - platform: template
#     id: exit_color_ready
#     name: Exit Color Ready
#   - platform: template
#     id: conveyor_run_request
#     name: Conveyor Run Request
#     # Latch an entry detection until the object reaches the close-range exit
#     # capture position. Returning an empty optional keeps the previous state.
#     lambda: |-
#       if (id(exit_capture_position).state) return false;
#       if (id(entry_object_present).state) return true;
#       return {};
#
# # The FeatherS2 onboard APA102 uses a dedicated write-only SPI bus. GPIO21
# # enables the FeatherS2 secondary 3.3V regulator used by onboard peripherals.
# spi:
#   - id: status_spi
#     clk_pin: GPIO45
#     mosi_pin: GPIO40
#
# switch:
#   - platform: gpio
#     id: ldo2
#     pin: GPIO21
#     restore_mode: ALWAYS_ON
#     internal: true
#
# output:
#   # CircuitPython board.D21 -> FeatherS2 GPIO38 -> DRV8833 AIN1.
#   - platform: ledc
#     id: motor_ain1_pwm
#     pin: GPIO38
#     frequency: 20kHz
#   # CircuitPython board.D20 -> FeatherS2 GPIO33 -> DRV8833 AIN2.
#   - platform: ledc
#     id: motor_ain2_pwm
#     pin: GPIO33
#     frequency: 20kHz
#   # CircuitPython board.D5 -> FeatherS2 GPIO1 -> DRV8833 SLP.
#   - platform: gpio
#     id: motor_sleep
#     pin: GPIO1
#
# fan:
#   - platform: hbridge
#     id: conveyor_motor
#     name: Conveyor Motor
#     # Forward matches the tested CircuitPython state:
#     # AIN1/GPIO38 high and AIN2/GPIO33 low.
#     pin_a: motor_ain1_pwm
#     pin_b: motor_ain2_pwm
#     decay_mode: slow
#     speed_count: 100
#     restore_mode: ALWAYS_OFF
#     on_turn_on:
#       - if:
