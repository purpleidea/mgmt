# Sort LEGO bricks by colour with mgmt and an ESPHome conveyor belt.
#
# The firmware lives in esphome-conveyor.yaml, next to this file. Flash it
# first, then run:
#
#	mgmt run --tmp-prefix lang examples/lang/esphome-conveyor.mcl
#
# This is a development-bench example, not a machine-safety system. Before
# energizing a motor, review the real board pinout and DRV8833 wiring, add a
# current limit and guards, and wire a physical emergency stop in series with
# the motor supply or driver enable. A software stop is not an emergency stop.
# Keep hands, hair, clothing, and loose parts clear of the belt.
#
# The flow, once a brick is dropped on the belt:
#
#	1. The entry sensor sees it. The belt is still stopped, and the status
#	   light blinks yellow to say that we noticed and are about to move.
#	2. mgmt starts the belt.
#	3. The brick reaches the exit sensor. The firmware stops the belt
#	   there on its own, and captures one averaged color reading.
#	4. mgmt classifies that reading and sets the light: solid red or solid
#	   blue for a brick it recognizes, rainbow for anything else.
#	5. Take the brick off and the light goes back to idle white.
#
# If a brick never reaches the exit, because it jammed or fell off, the
# firmware gives up 20 seconds into the run and stops the belt. Dropping the
# next brick on the entry sensor re-arms it; no reset button is involved.
#
# Who does what:
#
#	The firmware owns the hardware truth. Sensors, the H-bridge, the color
#	average, and stopping the belt if a brick is at the exit, if a run
#	overruns, or if mgmt goes away. It never touches the status light.
#
#	mgmt owns the policy, and it is all right here: when the belt runs,
#	what color a brick is, and what the light shows. Edit a threshold
#	below and save; the belt changes behavior immediately, with no
#	reflash and no restart. That is the point of the demo.
#
# Why only red and blue:
#
#	Bench captures of red, green, blue, yellow, and white bricks gave the
#	average normalized mixes below, sampled at close range with the exit
#	APDS9960 running proximity and color together at 4x gain and ~200ms
#	integration.
#
#	red     48 / 22 / 30   strongly dominant, unmistakable
#	blue    29 / 31 / 40   clearly dominant
#	green   26 / 37 / 37   green and blue effectively tie
#	yellow  35 / 31 / 35   does not read as red plus green at all
#	white   overlaps both blue and yellow
#
#	Only red and blue separate cleanly, so only those two are claimed.
#	Everything else is honestly reported as unknown rather than guessed.
#	Better illumination beside the sensor is what it would take to add
#	more colors; see the note on Exit Clear below.

import "fmt"
import "net/esphome"

$endpoint = "esphome-conveyor"
$motor = "Conveyor Motor"
$light = "Status Light"

$entry_present = esphome.binary_sensor($endpoint, "Entry Object Present")
$in_transit = esphome.binary_sensor($endpoint, "Block In Transit")
$at_exit = esphome.binary_sensor($endpoint, "Exit Object Present")
$color_ready = esphome.binary_sensor($endpoint, "Exit Color Ready")
$red = esphome.sensor($endpoint, "Exit Red")
$green = esphome.sensor($endpoint, "Exit Green")
$blue = esphome.sensor($endpoint, "Exit Blue")
$clear = esphome.sensor($endpoint, "Exit Clear")

# Normalize the captured reading. ESPHome reports each channel as
# ADC/65535*100, but all three share that scaling, so these ratios are the
# same ones the bench captures produced. Guard the divisor: a rejected
# capture publishes zeroes.
$rgb_sum = $red + $green + $blue
$rgb_total = if $rgb_sum > 0.0 { $rgb_sum } else { 1.0 }
$red_mix = $red / $rgb_total
$green_mix = $green / $rgb_total
$blue_mix = $blue / $rgb_total

# An empty belt reads as roughly 44 / 27 / 30, which is close enough to a real
# red brick to fool the test below, so a color only counts when the sensor
# actually saw light. Exit Clear is a percentage of full scale, and 0.15% is
# the same raw CLEAR floor of 100 that the firmware applies per sample.
$lit = $color_ready and $clear >= 0.15

$detected = if $lit and $red_mix >= 0.44 and $green_mix <= 0.27 {
	"red"
} else {
	if $lit and $blue_mix >= 0.39 and $green_mix <= 0.33 {
		"blue"
	} else {
		"unknown"
	}
}
$known = $detected == "red" or $detected == "blue"

esphome:endpoint $endpoint {
	host => "esphome-conveyor.local",
	# Public sample key: replace it here and in the firmware before real use.
	key => "kJ7hc0lJ0Zw9N3DcJzXn1kJ7hc0lJ0Zw9N3DcJzXn1k=",
	interval => 0,
	logs => "info",
}

esphome:fan $motor {
	endpoint => $endpoint,
	# Run while a brick is on its way and the exit is clear. The firmware
	# enforces that same exit rule locally as a backstop, so both sides
	# have to agree here: if we asked for a running belt while the firmware
	# insisted on a stopped one, the two would fight and never converge.
	state => if $in_transit and not $at_exit {
		"on"
	} else {
		"off"
	},
	speed => 100,
	direction => "forward",
	# On a long outage, stop before retrying the desired state.
	stop => 5,
	Meta:retry => -1,
	Meta:delay => 5000,
}

esphome:light $light {
	endpoint => $endpoint,
	state => "on",
	brightness => 0.35,
	# A selected effect overrides the color, so this only shows through
	# when no effect is running: solid for a brick we recognize, idle
	# white otherwise.
	color => if $known {
		$detected
	} else {
		"white"
	},
	# The device owns both animations. We only name the one we want.
	#
	# Blinking means a brick is on its way and the belt is running. Once it
	# arrives, it is either a color we know, and goes solid, or it is not,
	# and the rainbow runs until somebody lifts it off. The blink also has
	# to stand down the moment the brick lands, and the entry and exit
	# sensors reach us as two separate messages, so the exit wins here
	# rather than leaving a window where both look true at once.
	effect => if $known {
		""
	} else {
		if $at_exit {
			"Rainbow"
		} else {
			if $in_transit {
				"Traveling Blink"
			} else {
				""
			}
		}
	},
}

print "conveyor" {
	msg => fmt.printf(
		"entry=%v transit=%v exit=%v ready=%v mix=(%f, %f, %f) clear=%f color=%s",
		$entry_present,
		$in_transit,
		$at_exit,
		$color_ready,
		$red_mix,
		$green_mix,
		$blue_mix,
		$clear,
		$detected,
	),
}

Esphome:Endpoint[$endpoint] -> Esphome:Fan[$motor]
Esphome:Endpoint[$endpoint] -> Esphome:Light[$light]
