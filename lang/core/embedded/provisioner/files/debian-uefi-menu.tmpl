set mgmt_menu=1
set default=0
set timeout=15

menuentry 'Install {{ .Distro }} {{ .Version }} {{ .Arch }} ( preseed )' --class debian --class gnu-linux --class gnu --class os {
	linux /{{ .Distro }}{{ .Version }}-{{ .Arch }}/vmlinuz {{ .Auto_args }}
	initrd /{{ .Distro }}{{ .Version }}-{{ .Arch }}/initrd.img
}

menuentry 'Install {{ .Distro }} {{ .Version }} {{ .Arch }} ( manual )' --class debian --class gnu-linux --class gnu --class os {
	linux /{{ .Distro }}{{ .Version }}-{{ .Arch }}/vmlinuz {{ .Manual_args }}
	initrd /{{ .Distro }}{{ .Version }}-{{ .Arch }}/initrd.img
}

# XXX: This loads the kernel and initrd over http, which is much faster than
# tftp. Make it the default once we know that it works everywhere.
menuentry 'Install {{ .Distro }} {{ .Version }} {{ .Arch }} ( preseed, http )' --class debian --class gnu-linux --class gnu --class os {
	linux (http,{{ .Http_host }})/{{ .Distro }}{{ .Version }}-{{ .Arch }}/vmlinuz {{ .Auto_args }}
	initrd (http,{{ .Http_host }})/{{ .Distro }}{{ .Version }}-{{ .Arch }}/initrd.img
}
