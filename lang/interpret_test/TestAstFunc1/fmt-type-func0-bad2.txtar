-- CONFIG --
{
	"nofmt": true
}
-- main.mcl --
# type signature is multi-line without a trailing comma on last arg: bad
$f func( # bad
	str,
	str
) str = func($a, $b) {
	$a + $b + "\n"
}

test "f" {
	comment => $f("a", "b"),
}
-- OUTPUT --
# err: errLexParse: parser: `syntax error: unexpected NEWLINE, expecting COMMA`: /main.mcl @ 4:5-4:6
