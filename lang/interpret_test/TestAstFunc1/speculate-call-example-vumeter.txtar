-- main.mcl --
import "fmt"
import "example"

# The call is speculated before unification has checked the types of its args,
# so that must give a type error, and not a panic.
$s = fmt.printf("%v", example.vumeter(42, 1, 2.0))
test "${s}" {}
-- OUTPUT --
# err: errUnify: type error: int != str: /main.mcl @ 6:23-6:50
