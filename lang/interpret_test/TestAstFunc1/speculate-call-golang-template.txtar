-- main.mcl --
import "fmt"
import "golang"

# The call is speculated before unification has checked the types of its args,
# so that must give a type error, and not a panic.
$s = fmt.printf("%v", golang.template(42, "x"))
test "${s}" {}
-- OUTPUT --
# err: errUnify: type error: int != str: /main.mcl @ 6:23-6:47
