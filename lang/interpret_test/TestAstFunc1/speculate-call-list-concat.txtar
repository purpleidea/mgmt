-- main.mcl --
import "fmt"
import "list"

# The call is speculated before unification has checked the types of its args,
# so that must give a type error, and not a panic.
$s = fmt.printf("%v", list.concat(["a"], "b"))
test "${s}" {}
-- OUTPUT --
# err: errUnify: type error: str != list: /main.mcl @ 6:23-6:46
