-- main.mcl --
import "fmt"
import "value"

# The call is speculated before unification has checked the types of its args,
# so that must give a type error, and not a panic.
$s = fmt.printf("%v", value.get_str(42)->value)
test "${s}" {}
-- OUTPUT --
# err: errUnify: type error: int != str: /main.mcl @ 6:23-6:40
