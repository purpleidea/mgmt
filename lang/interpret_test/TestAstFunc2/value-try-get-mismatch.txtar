-- main.mcl --
import "fmt"
import "value"

# A value of the wrong type is a permanent error, so this isn't caught.
test [fmt.printf("%d", value.try_get_int("str1") <|> -1)] {}
-- LOCAL/value/str1 str --
"hello"
-- OUTPUT --
