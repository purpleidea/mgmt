-- main.mcl --
import "fmt"
import "world"

# This key exists, so we get its value.
test [world.try_getval("key1") <|> "default1"] {}

# This key exists, but its value is empty, which isn't the same as missing.
test [fmt.printf("key2: '%s'", world.try_getval("key2") <|> "default2")] {}

# This key doesn't exist, so the except operator catches the error.
test [world.try_getval("key3") <|> "default3"] {}
-- WORLD/str/key1 --
hello
-- WORLD/str/key2 --
-- OUTPUT --
Vertex: test[default3]
Vertex: test[hello]
Vertex: test[key2: '']
