import "deploy"
import "fmt"
import "golang"
import "local"
import "os"

class database($config) {
	$namespace = $config->namespace # outside "name" of the db folder
	$version str = $config->version # version of the db (eg: "15")
	$port int = $config->port # port the db runs on

	panic($namespace == "", "postgresql:database $namespace is empty")
	panic($version == "", "postgresql:database $version is empty")

	# TODO: ensure package is the right $version
	if os.is_family_redhat() { # we only use fedora atm
		pkg [
			"postgresql",
		] {
			state => "installed",
		}
	}
	if os.is_family_debian() {
		pkg [
			"postgresql",
		] {
			state => "installed",
		}
	}

	$cname = "${version}/${namespace}" # cluster name
	$etc = "/etc/postgresql/${version}/${namespace}/"
	$var = "/var/lib/postgresql/${version}/${namespace}/"
	$pid = "/var/run/postgresql/${version}-${namespace}.pid" # pid file
	$svc = "postgresql@${version}-${namespace}" # generated service name

	pkg "postgresql" {
		state => "installed",

		Before => File["${etc}"],
	}

	file "${etc}" {
		state => $const.res.file.state.exists,
		recurse => true,
		purge => true,
		owner => "postgres",
		group => "postgres",
		mode => "ug=rwx,o=rx", # dir

		Depend => Pkg["postgresql"],
		Before => Svc["${svc}"],
	}

	file "${etc}conf.d/" {
		state => $const.res.file.state.exists,
		recurse => true,
		purge => true,
		owner => "postgres",
		group => "postgres",
		mode => "ug=rwx,o=rx", # dir

		Depend => Pkg["postgresql"],
		Before => Svc["${svc}"],
	}

	file "${var}" {
		state => $const.res.file.state.exists,
		recurse => false,
		purge => false,
		owner => "postgres",
		group => "postgres",
		# Permissions should be u=rwx (0700) or u=rwx,g=rx (0750).
		mode => "u=rwx,g=rx,o=", # dir

		Depend => Pkg["postgresql"],
		Before => Svc["${svc}"],
	}

	$tmpl = struct{
		cname => $cname,
		port => $port,
		etc => $etc,
		var => $var,
		pid => $pid,
	}

	file "${etc}postgresql.conf" {
		state => $const.res.file.state.exists,
		content => golang.template(deploy.readfile("/files/postgresql.conf.tmpl"), $tmpl),
		owner => "postgres",
		group => "postgres",
		mode => "ug=rw,o=r",

		Notify => Svc["${svc}"],
		Before => Svc["${svc}"],
	}
	#file "${etc}pg_hba.conf" {
	#	state => $const.res.file.state.exists,
	#	content => golang.template(deploy.readfile("/files/pg_hba.conf.tmpl"), $tmpl),
	#	owner => "postgres",
	#	group => "postgres",
	#	mode => "ug=rw,o=r",
	#
	#	Notify => Svc["${svc}"],
	#}
	file "${etc}pg_ident.conf" {
		state => $const.res.file.state.exists,
		content => deploy.readfile("/files/pg_ident.conf"),
		owner => "postgres",
		group => "postgres",
		mode => "ug=rw,o=r",

		Notify => Svc["${svc}"],
		Before => Svc["${svc}"],
	}

	file "${etc}pg_ctl.conf" {
		state => $const.res.file.state.exists,
		content => deploy.readfile("/files/pg_ctl.conf"),
		owner => "postgres",
		group => "postgres",
		mode => "ug=rw,o=r",

		Notify => Svc["${svc}"],
		Before => Svc["${svc}"],
	}

	file "${etc}start.conf" {
		state => $const.res.file.state.exists,
		content => deploy.readfile("/files/start.conf"),
		owner => "postgres",
		group => "postgres",
		mode => "ug=rw,o=r",

		Notify => Svc["${svc}"],
		Before => Svc["${svc}"],
	}

	file "${etc}environment" {
		state => $const.res.file.state.exists,
		content => deploy.readfile("/files/environment"),
		owner => "postgres",
		group => "postgres",
		mode => "ug=rw,o=r",

		Notify => Svc["${svc}"],
		Before => Svc["${svc}"],
	}

	svc "${svc}" {
		state => "running",
		startup => "enabled",

		Depend => Pkg["postgresql"],
	}

	$vardir = local.vardir("postgresql/")

	include auth_base # XXX: for now
}

# Disables a running database. Does not delete the data.
class disable($config) {
	$namespace = $config->namespace # outside "name" of the db folder
	$version str = $config->version # version of the db (eg: "15")
	$port int = $config->port # port the db runs on

	panic($namespace == "", "postgresql:disable $namespace is empty")
	panic($version == "", "postgresql:disable $version is empty")

	$cname = "${version}/${namespace}" # cluster name
	$etc = "/etc/postgresql/${version}/${namespace}/"
	$svc = "postgresql@${version}-${namespace}" # generated service name

	svc "${svc}" {
		state => "stopped",
		startup => "disabled",
	}
}

class database:auth_base() {
	file "${vardir}pg_hba.d/" {
		state => $const.res.file.state.exists,
		recurse => true,
		purge => true,
		owner => "postgres",
		group => "postgres",
		mode => "ug=rwx,o=rx", # dir
	}

	file "${vardir}pg_hba.conf.header" {
		state => $const.res.file.state.exists,
		content => deploy.readfile("/files/pg_hba.conf.header"), # static, no template!
		owner => "postgres",
		group => "postgres",
		mode => "ug=rw,o=r",
	}

	file "${etc}pg_hba.conf" {
		state => $const.res.file.state.exists,
		fragments => [
			"${vardir}pg_hba.conf.header", # also pull this one file
			"${vardir}pg_hba.d/", # pull from this dir
		],
		owner => "postgres",
		group => "postgres",
		mode => "ug=rw,o=r",

		Depend => File["${vardir}pg_hba.conf.header"],
		Depend => File["${vardir}pg_hba.d/"],
		Notify => Svc["${svc}"],
		Before => Svc["${svc}"],
	}
}

# HBA stands for host-based authentication.
class database:auth($name, $st) {
	include auth_base

	$type = $st->type <|> "host"
	$database = $st->database <|> "all"
	$user = $st->user <|> "all"
	$address = $st->address # required
	$method = $st->method <|> "scram-sha-256" # "peer" is the other method
	$comment = $st->comment <|> ""

	$tmpl = struct{
		type => $type,
		database => $database,
		user => $user,
		address => $address,
		method => $method,
		comment => "${comment}",
	}

	file "${vardir}pg_hba.d/${name}.pg_hba" {
		state => $const.res.file.state.exists,
		content => golang.template(deploy.readfile("/files/pg_hba.frag.tmpl"), $tmpl),
		owner => "postgres",
		group => "postgres",
		mode => "ug=rw,o=r",

		Before => File["${etc}pg_hba.conf"],
		Depend => File["${vardir}pg_hba.d/"],
	}
}

class database:conf($name, $content) {
	$content = $st->content

	file "${etc}conf.d/" {
		state => $const.res.file.state.exists,
		content => $content,
		owner => "postgres",
		group => "postgres",
		mode => "ug=rw,o=r",

		Notify => Svc["${svc}"],
		Before => Svc["${svc}"],
	}
}
